{
  "name": "gmt-procurement-cpanel",
  "version": "0.15.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prisma:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "prisma:push:staging": "prisma db push --schema=apps/api/prisma/schema.prisma",
    "prisma:seed": "tsx apps/api/prisma/seed.ts",
    "build:api": "cd apps/api && ../../node_modules/.bin/nest build",
    "build:web": "cd apps/web && ../../node_modules/.bin/tsc -b && ../../node_modules/.bin/vite build",
    "build": "npm run build:api && npm run build:web",
    "setup:staging": "npm run prisma:generate && npm run build && npm run prisma:seed && npm run cpanel:preflight",
    "start:cpanel": "node app.js",
    "cpanel:preflight": "node deploy/cpanel/preflight.cjs"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.0.6",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "6.19.3",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "prisma": "6.19.3",
    "puppeteer-core": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@prisma/adapter-mariadb": "6.19.3",
    "mariadb": "^3.4.5"
  },
  "prisma": {
    "seed": "tsx apps/api/prisma/seed.ts"
  }
}
